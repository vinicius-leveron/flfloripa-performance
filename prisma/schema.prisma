generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

enum ChannelPlatform {
  INSTAGRAM
  TIKTOK
  LINKEDIN
  YOUTUBE
}

enum ContentTheme {
  ENSINAMENTO
  CONVITE
  EXPERIENCIA
  REFORCO_CONVITE
  DICA_LEITURA
  PODCAST
  DIVULGACAO
  OUTRO
}

enum ContentFormat {
  FEED_POST
  REEL
  STORY
  VIDEO_LONGO
  IMAGEM_ESTATICA
  EVENTO
  REPOST
  OUTRO
}

enum ChannelStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum ContentCategory {
  EDUCATIONAL
  INSTITUTIONAL
  INVITE
  TESTIMONY
}

enum ContentStatus {
  PLANNED
  CREATED
  PUBLISHED
}

enum FunnelSource {
  AUTO
  MANUAL
}

enum AlertType {
  ENGAGEMENT_DROP
  CAMPAIGN_UNDERPERFORM
  CADENCE_MISS
}

enum ReportType {
  WEEKLY
  MONTHLY
  CUSTOM
}

enum WebinarStatus {
  SCHEDULED
  LIVE
  ENDED
  REPLAY_ONLY
}

// Form Builder enums
enum FormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FieldType {
  TEXT
  EMAIL
  PHONE
  TEXTAREA
  SELECT
  CHECKBOX
  DATE
}

enum FormAccessMode {
  PUBLIC
  EMBED
  STAFF
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?  @map("password_hash")
  image        String?
  role         UserRole @default(VIEWER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  accounts         Account[]
  channels         Channel[]
  calendarEntries  ContentCalendarEntry[] @relation("assignee")
  registeredLeads  Lead[]                 @relation("registeredBy")
  responsibleLeads Lead[]                 @relation("responsibleFor")
  leadEvents       LeadEvent[]            @relation("createdBy")
  reports          Report[]               @relation("generatedBy")

  // Form Builder relations
  formsCreated    FormTemplate[]   @relation("formCreator")
  formSubmissions FormSubmission[] @relation("submissionCreator")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Channel {
  id             String          @id @default(cuid())
  platform       ChannelPlatform
  accountName    String          @map("account_name")
  accountId      String          @map("account_id")
  accessToken    String          @map("access_token")
  refreshToken   String?         @map("refresh_token")
  tokenExpiresAt DateTime?       @map("token_expires_at")
  status         ChannelStatus   @default(CONNECTED)
  userId         String          @map("user_id")
  lastSyncAt     DateTime?       @map("last_sync_at")
  createdAt      DateTime        @default(now()) @map("created_at")

  user            User                   @relation(fields: [userId], references: [id])
  metrics         Metric[]
  posts           Post[]
  campaigns       Campaign[]
  calendarEntries ContentCalendarEntry[]
  alerts          Alert[]                @relation("channelAlerts")

  @@map("channels")
}

model Post {
  id          String   @id @default(cuid())
  externalId  String   @map("external_id")
  channelId   String   @map("channel_id")
  title       String?
  url         String?
  publishedAt DateTime @map("published_at")
  metrics     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, externalId])
  @@map("posts")
}

model Metric {
  id             String   @id @default(cuid())
  channelId      String   @map("channel_id")
  date           DateTime @db.Date
  impressions    Int      @default(0)
  reach          Int      @default(0)
  engagement     Int      @default(0)
  profileVisits  Int      @default(0) @map("profile_visits")
  linkClicks     Int      @default(0) @map("link_clicks")
  followersCount Int      @default(0) @map("followers_count")
  createdAt      DateTime @default(now()) @map("created_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, date])
  @@index([channelId, date])
  @@map("metrics")
}

model Campaign {
  id             String         @id @default(cuid())
  metaCampaignId String         @unique @map("meta_campaign_id")
  channelId      String         @map("channel_id")
  name           String
  status         CampaignStatus @default(ACTIVE)
  objective      String?
  budget         Float          @default(0)
  startDate      DateTime?      @map("start_date")
  endDate        DateTime?      @map("end_date")
  createdAt      DateTime       @default(now()) @map("created_at")

  channel Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  metrics CampaignMetric[]
  alerts  Alert[]          @relation("campaignAlerts")

  @@map("campaigns")
}

model CampaignMetric {
  id          String   @id @default(cuid())
  campaignId  String   @map("campaign_id")
  date        DateTime @db.Date
  spend       Float    @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  cpm         Float    @default(0)
  cpc         Float    @default(0)
  ctr         Float    @default(0)
  conversions Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([campaignId, date])
  @@map("campaign_metrics")
}

model Funnel {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  color       String? // cor para UI (hex)
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  stages FunnelStage[]
  leads  Lead[]

  @@map("funnels")
}

model FunnelStage {
  id          String       @id @default(cuid())
  funnelId    String       @map("funnel_id")
  name        String
  position    Int
  description String?
  source      FunnelSource @default(MANUAL)
  syncTrello  Boolean      @default(false) @map("sync_trello")
  createdAt   DateTime     @default(now()) @map("created_at")

  funnel     Funnel      @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  leads      Lead[]
  eventsFrom LeadEvent[] @relation("fromStage")
  eventsTo   LeadEvent[] @relation("toStage")

  // Form Builder: formularios que direcionam leads para este estagio
  formTemplates FormTemplate[]

  @@unique([funnelId, position])
  @@index([funnelId])
  @@map("funnel_stages")
}

model Lead {
  id             String   @id @default(cuid())
  name           String
  email          String?
  phone          String?
  channelOrigin  String?  @map("channel_origin")
  funnelId       String   @map("funnel_id")
  currentStageId String   @map("current_stage_id")
  registeredById String   @map("registered_by_id")
  notes          String?
  isDeleted      Boolean  @default(false) @map("is_deleted")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Perfil / Avatar do lead
  lifeMoment String? @map("life_moment")
  inquiry    String?
  source     String?

  // Tracking de origem
  campaignId  String? @map("campaign_id")
  adSpend     Float?  @map("ad_spend")
  utmSource   String? @map("utm_source")
  utmMedium   String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")

  // VSL tracking
  vslWatched   Boolean @default(false) @map("vsl_watched")
  vslWatchTime Int?    @map("vsl_watch_time")

  // Responsável pelo lead
  responsibleUserId String? @map("responsible_user_id")

  // Integração Trello SIPE
  trelloCardId String? @map("trello_card_id")

  funnel               Funnel                @relation(fields: [funnelId], references: [id])
  currentStage         FunnelStage           @relation(fields: [currentStageId], references: [id])
  registeredBy         User                  @relation("registeredBy", fields: [registeredById], references: [id])
  responsibleUser      User?                 @relation("responsibleFor", fields: [responsibleUserId], references: [id])
  events               LeadEvent[]
  webinarRegistrations WebinarRegistration[]
  formSubmissions      FormSubmission[]

  @@index([funnelId])
  @@index([currentStageId])
  @@index([isDeleted])
  @@index([responsibleUserId])
  @@map("leads")
}

model LeadEvent {
  id          String   @id @default(cuid())
  leadId      String   @map("lead_id")
  fromStageId String   @map("from_stage_id")
  toStageId   String   @map("to_stage_id")
  notes       String?
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  lead      Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStage FunnelStage @relation("fromStage", fields: [fromStageId], references: [id])
  toStage   FunnelStage @relation("toStage", fields: [toStageId], references: [id])
  createdBy User        @relation("createdBy", fields: [createdById], references: [id])

  @@index([leadId])
  @@map("lead_events")
}

model ContentCalendarEntry {
  id            String          @id @default(cuid())
  title         String
  description   String?
  channelId     String?         @map("channel_id")
  category      ContentCategory
  assigneeId    String?         @map("assignee_id")
  contentTheme  ContentTheme?   @map("content_theme")
  contentFormat ContentFormat?  @map("content_format")
  status        ContentStatus   @default(PLANNED)
  scheduledDate DateTime        @map("scheduled_date") @db.Date
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  channel  Channel? @relation(fields: [channelId], references: [id])
  assignee User?    @relation("assignee", fields: [assigneeId], references: [id])

  @@index([scheduledDate])
  @@index([channelId])
  @@map("content_calendar_entries")
}

model Alert {
  id         String    @id @default(cuid())
  type       AlertType
  channelId  String?   @map("channel_id")
  campaignId String?   @map("campaign_id")
  message    String
  data       Json?
  isRead     Boolean   @default(false) @map("is_read")
  createdAt  DateTime  @default(now()) @map("created_at")

  channel  Channel?  @relation("channelAlerts", fields: [channelId], references: [id])
  campaign Campaign? @relation("campaignAlerts", fields: [campaignId], references: [id])

  @@index([isRead])
  @@map("alerts")
}

model Report {
  id            String     @id @default(cuid())
  type          ReportType
  periodStart   DateTime   @map("period_start") @db.Date
  periodEnd     DateTime   @map("period_end") @db.Date
  generatedById String     @map("generated_by_id")
  fileUrl       String?    @map("file_url")
  createdAt     DateTime   @default(now()) @map("created_at")

  generatedBy User @relation("generatedBy", fields: [generatedById], references: [id])

  @@map("reports")
}

model CadenceGoal {
  id           String          @id @default(cuid())
  platform     ChannelPlatform
  postsPerWeek Int             @map("posts_per_week")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@unique([platform])
  @@map("cadence_goals")
}

model AlertThreshold {
  id             String   @id @default(cuid())
  metricName     String   @map("metric_name")
  dropPercentage Int      @map("drop_percentage")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([metricName])
  @@map("alert_thresholds")
}

model Webinar {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?
  scheduledAt DateTime      @map("scheduled_at")
  replayUrl   String?       @map("replay_url")
  status      WebinarStatus @default(SCHEDULED)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // Form Builder: formulario de registro customizavel
  formTemplateId String? @unique @map("form_template_id")

  registrations WebinarRegistration[]
  formTemplate  FormTemplate?         @relation("webinarForm", fields: [formTemplateId], references: [id])

  @@map("webinars")
}

model WebinarRegistration {
  id           String   @id @default(cuid())
  leadId       String   @map("lead_id")
  webinarId    String   @map("webinar_id")
  registeredAt DateTime @default(now()) @map("registered_at")

  // Presença simplificada
  attendedLive  Boolean @default(false) @map("attended_live")
  watchedReplay Boolean @default(false) @map("watched_replay")

  // UTM da inscrição
  utmSource   String? @map("utm_source")
  utmMedium   String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")

  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  webinar Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@unique([leadId, webinarId])
  @@index([webinarId])
  @@index([leadId])
  @@map("webinar_registrations")
}

// =============================================================================
// FORM BUILDER MODELS
// =============================================================================

model FormTemplate {
  id          String     @id @default(cuid())
  name        String // Nome interno
  slug        String     @unique // URL-friendly identifier
  title       String // Titulo exibido no form
  description String? // Descricao/intro do form
  status      FormStatus @default(DRAFT)

  // Configuracoes de integracao com Lead
  targetStageId     String? @map("target_stage_id") // FunnelStage para novos leads
  sendNotification  Boolean @default(true) @map("send_notification")
  notificationEmail String? @map("notification_email") // Email para alertar CIP
  createTrelloCard  Boolean @default(false) @map("create_trello_card")

  // Configuracoes de exibicao
  submitButtonText String  @default("Enviar") @map("submit_button_text")
  successMessage   String? @map("success_message")
  redirectUrl      String? @map("redirect_url")

  // Tracking
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  fields      FormField[]
  submissions FormSubmission[]
  createdBy   User             @relation("formCreator", fields: [createdById], references: [id])
  targetStage FunnelStage?     @relation(fields: [targetStageId], references: [id])
  webinar     Webinar?         @relation("webinarForm")

  @@index([status])
  @@index([createdById])
  @@map("form_templates")
}

model FormField {
  id          String    @id @default(cuid())
  formId      String    @map("form_id")
  fieldType   FieldType @map("field_type")
  name        String // Nome interno do campo (para dados)
  label       String // Label exibido
  placeholder String?
  helpText    String?   @map("help_text")
  required    Boolean   @default(false)
  position    Int // Ordem no form

  // Validacao (JSON: { minLength, maxLength, pattern, etc. })
  validation Json?

  // Opcoes para SELECT, CHECKBOX (JSON: [{ label, value }, ...])
  options Json?

  // Logica condicional (JSON: { showWhen: { fieldName, operator, value } })
  conditionalLogic Json? @map("conditional_logic")

  // Mapeamento para campo do Lead (name, email, phone, etc.)
  leadFieldMapping String? @map("lead_field_mapping")

  // Valor padrao para campos HIDDEN
  defaultValue String? @map("default_value")

  createdAt DateTime @default(now()) @map("created_at")

  form      FormTemplate        @relation(fields: [formId], references: [id], onDelete: Cascade)
  responses FormFieldResponse[]

  @@index([formId, position])
  @@map("form_fields")
}

model FormSubmission {
  id     String  @id @default(cuid())
  formId String  @map("form_id")
  leadId String? @map("lead_id") // Lead criado/vinculado

  // Contexto
  ipAddress   String? @map("ip_address")
  userAgent   String? @map("user_agent")
  referrerUrl String? @map("referrer_url")

  // UTM tracking
  utmSource   String? @map("utm_source")
  utmMedium   String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")

  // Modo de acesso
  accessMode    FormAccessMode @default(PUBLIC) @map("access_mode")
  submittedById String?        @map("submitted_by_id") // User se modo STAFF

  createdAt DateTime @default(now()) @map("created_at")

  form        FormTemplate        @relation(fields: [formId], references: [id], onDelete: Cascade)
  lead        Lead?               @relation(fields: [leadId], references: [id])
  submittedBy User?               @relation("submissionCreator", fields: [submittedById], references: [id])
  responses   FormFieldResponse[]

  @@index([formId])
  @@index([leadId])
  @@index([createdAt])
  @@map("form_submissions")
}

model FormFieldResponse {
  id           String @id @default(cuid())
  submissionId String @map("submission_id")
  fieldId      String @map("field_id")
  value        String // Valor como string, parseado pelo fieldType

  submission FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  field      FormField      @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("form_field_responses")
}
